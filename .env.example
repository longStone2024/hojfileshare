# ===== 数据库 =====
POSTGRES_DB=cloud
POSTGRES_USER=cloud
# 只用字母数字，避免 URL 里转义问题
POSTGRES_PASSWORD=please_change_me_64bit

# ===== 后端 =====
# 首次启动会创建 root，密码用这个；请尽快在管理后台修改
ROOT_PASSWORD=please_change_me_too
SESSION_TTL_DAYS=7
DEFAULT_USER_QUOTA_MB=1024
MAX_UPLOAD_MB=100
# 1 表示由服务器代理下载（OJ 有防盗链时开，会走服务器带宽）
PROXY_DOWNLOAD=0

# ===== 前端对外端口 =====
FRONTEND_PORT=8080